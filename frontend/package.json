{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\" --config ./.prettierrc.json"
  },
  "dependencies": {
    "react": "^18.2.0", // Example, ensure you have react and react-dom
    "react-dom": "^18.2.0" // Example
  },
  "devDependencies": {
    "@eslint/js": "^9.3.0", // or latest
    "eslint": "^9.3.0", // or latest
    "eslint-config-prettier": "^9.1.0", // For Prettier compatibility
    "eslint-plugin-react": "^7.34.2", // Ensure compatibility with ESLint 9 flat config
    "eslint-plugin-react-hooks": "^4.6.2", // For React Hooks rules
    "eslint-plugin-react-refresh": "^0.4.7", // For Vite/React Fast Refresh
    "prettier": "^3.2.5", // or latest
    "typescript": "~5.4.5", // or latest compatible with your project
    "typescript-eslint": "^7.10.0", // or latest
    "vite": "^5.2.0" // or latest
  }
